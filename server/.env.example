PORT=8080
ALLOWED_ORIGIN=*

# IBM watsonx.ai Developer access values
WATSONX_API_KEY=replace_with_a_new_key
WATSONX_PROJECT_ID=replace_with_project_id
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=replace_with_available_model_id
WATSONX_API_VERSION=2023-10-25

# Live Google Shopping result provider
SERPAPI_API_KEY=replace_with_serpapi_key

# 같은 검색어를 다시 요청할 때 사용할 메모리 캐시 시간(기본 5분)
SEARCH_CACHE_TTL_MS=300000
