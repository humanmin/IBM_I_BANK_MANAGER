<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_goal_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="8dp"
    android:background="@drawable/savings_goal_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/savings_goal_widget_dday_background"
            android:paddingStart="9dp"
            android:paddingTop="4dp"
            android:paddingEnd="9dp"
            android:paddingBottom="4dp"
            android:text="@string/savings_goal_widget_label"
            android:textColor="#4D6354"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_goal_dday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:includeFontPadding="false"
            android:textColor="#1F3528"
            android:textSize="32sp"
            android:textStyle="bold"
            tools:text="D-24" />

        <TextView
            android:id="@+id/widget_goal_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#1F3528"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="독거미 키보드" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_goal_image"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/savings_goal_widget_image_background"
        android:clipToOutline="true"
        android:contentDescription="@string/savings_goal_widget_image_description"
        android:padding="3dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_gift" />
</LinearLayout>
